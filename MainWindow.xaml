<Window x:Class="SCTimerV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SCTimerV2"
        mc:Ignorable="d"
        Title="SkeptiCamp Timer" Height="450" Width="800" Icon="/favicon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="199*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TxtMins" HorizontalAlignment="Left" Margin="63,9,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="18" Text="25"/>
        <Button x:Name="BtnStartStop" Content="Start" HorizontalAlignment="Left" Margin="98,8,0,0" VerticalAlignment="Top" Width="120" Click="BtnStartStop_Click" FontWeight="Bold"/>
        <Button x:Name="BtnPause" Content="Pause" HorizontalAlignment="Left" Margin="223,8,0,0" VerticalAlignment="Top" Width="75" Click="BtnPause_Click"/>
        <Viewbox Stretch="Uniform" Grid.Row="1">
            <Label x:Name="LblTimeDisplay" Content="00:00" Margin="10,10,10,10" FontWeight="Bold" Padding="0,0,0,0" FontSize="300"/>
        </Viewbox>
        <TextBlock HorizontalAlignment="Left" Margin="10,9,0,0" TextWrapping="Wrap" Text="Minutes:" VerticalAlignment="Top"/>
        <TextBox x:Name="LblQA" Margin="10,10,10,0" Grid.Row="1" TextWrapping="Wrap" Text="Mandatory Q&amp;A Time!" VerticalAlignment="Top" FontWeight="Bold" HorizontalContentAlignment="Center" Background="#FFE9FF00" BorderBrush="Black" Height="70" FontSize="50" IsReadOnly="True"/>

    </Grid>
</Window>
